{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turpinverse.dev/schemas/canon/v1",
  "title": "Turpinverse Canon",
  "description": "Canonical universe data schema for personas, organisations, events, and aliases",
  "type": "object",
  "required": ["version", "personas", "organisations", "events", "aliases", "toneGuidelines"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version of the canon dataset"
    },
    "personas": {
      "type": "array",
      "minItems": 15,
      "items": { "$ref": "#/$defs/Persona" }
    },
    "organisations": {
      "type": "array",
      "minItems": 8,
      "items": { "$ref": "#/$defs/Organisation" }
    },
    "events": {
      "type": "array",
      "minItems": 10,
      "items": { "$ref": "#/$defs/CanonEvent" }
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/AliasMap" }
    },
    "toneGuidelines": { "$ref": "#/$defs/ToneGuidelines" }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "Persona": {
      "type": "object",
      "required": [
        "id", "displayName", "historicalName", "title", "biography",
        "historicalAnchor", "isFictionalExtension", "organisationIds",
        "status", "email"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Modern user-facing name (e.g. Richard Turpin, not Dick Turpin)" },
        "historicalName": { "type": "string", "maxLength": 100, "description": "Legendary or historical inspiration name" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "maxLength": 100 }
        },
        "title": { "type": "string", "maxLength": 80 },
        "biography": { "type": "string" },
        "historicalAnchor": { "type": "string", "description": "Legend inspiration note — not a Wikipedia citation" },
        "isFictionalExtension": { "type": "boolean" },
        "temperament": { "type": "string", "maxLength": 200 },
        "organisationIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "minItems": 1
        },
        "birthYear": { "type": "integer", "minimum": 1700, "maximum": 1800 },
        "deathYear": { "type": "integer", "minimum": 1700, "maximum": 1800 },
        "status": {
          "type": "string",
          "enum": ["active", "deceased", "legend", "archived"]
        },
        "email": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+@turpinverse\\.uk$"
        },
        "phone": { "type": "string", "maxLength": 30 },
        "notes": { "type": "string", "maxLength": 500 }
      }
    },
    "Organisation": {
      "type": "object",
      "required": [
        "id", "tradingName", "description", "industry",
        "historicalAnchor", "memberPersonaIds", "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "tradingName": { "type": "string", "maxLength": 80 },
        "legalName": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "industry": { "type": "string", "maxLength": 60 },
        "historicalAnchor": { "type": "string", "description": "Legend or folklore inspiration note" },
        "parentOrganisationId": { "$ref": "#/$defs/slug" },
        "memberPersonaIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" },
          "minItems": 1
        },
        "foundedYear": { "type": "integer", "minimum": 1700, "maximum": 1800 },
        "status": {
          "type": "string",
          "enum": ["active", "dissolved", "legend"]
        },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[a-z0-9.-]+\\.turpinverse\\.uk$"
        }
      }
    },
    "CanonEvent": {
      "type": "object",
      "required": ["id", "date", "title", "description", "category"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "title": { "type": "string", "maxLength": 120 },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "enum": ["historical", "legend", "fictional"]
        },
        "personaIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" }
        },
        "organisationIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/slug" }
        },
        "location": { "type": "string", "maxLength": 100 }
      }
    },
    "AliasMap": {
      "type": "object",
      "required": ["alias", "personaId"],
      "properties": {
        "alias": { "type": "string", "maxLength": 100 },
        "personaId": { "$ref": "#/$defs/slug" },
        "context": { "type": "string", "maxLength": 200 }
      }
    },
    "ToneGuidelines": {
      "type": "object",
      "required": ["version", "principles", "examples", "forbiddenPatterns"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "principles": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 3
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["good", "bad", "reason"],
            "properties": {
              "good": { "type": "string" },
              "bad": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "forbiddenPatterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
