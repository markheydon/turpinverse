<BbCard>
    <BbCardHeader>
        <BbCardTitle>Dataset summary</BbCardTitle>
    </BbCardHeader>
    <BbCardContent>
        @if (ChartRows.Count == 0)
        {
            <BbTypographyMuted>No data to chart.</BbTypographyMuted>
        }
        else
        {
            <BbBarChart Data="@ChartRows" Horizontal="true" Height="320px" Title="Records by dataset">
                <BbChartTooltip />
                <BbXAxis DataKey="Name" />
                <BbYAxis />
                <BbBar DataKey="Count" FillKey="Fill" BorderRadius="4" ShowLabel="true" LabelPosition="LabelPosition.Right" />
            </BbBarChart>
        }
    </BbCardContent>
</BbCard>

@code {
    [Parameter] public Dictionary<string, int>? Counts { get; set; }

    private static readonly string[] ThemeFills =
    [
        "var(--chart-1)",
        "var(--chart-2)",
        "var(--chart-3)",
        "var(--chart-4)",
        "var(--chart-5)",
    ];

    private IReadOnlyList<SummaryRow> ChartRows =>
        Counts is null
            ? []
            : Counts
                .Select((pair, index) => new SummaryRow(pair.Key, pair.Value, ThemeFills[index % ThemeFills.Length]))
                .ToList();

    private sealed record SummaryRow(string Name, int Count, string Fill);
}
