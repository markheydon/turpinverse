<BbCard>
    <BbCardHeader>
        <BbCardTitle>Dataset summary</BbCardTitle>
    </BbCardHeader>
    <BbCardContent>
        @if (ChartRows.Count == 0)
        {
            <BbTypographyMuted>No data to chart.</BbTypographyMuted>
        }
        else
        {
            <BbPieChart Data="@ChartRows" Height="320px" Title="Records by dataset">
                <BbChartTooltip />
                <BbChartLegend />
                <BbPie DataKey="Count" NameKey="Name" InnerRadius="45" ShowLabels="true" LabelFormatter="{b}: {c}" />
            </BbPieChart>
        }
    </BbCardContent>
</BbCard>

@code {
    [Parameter] public Dictionary<string, int>? Counts { get; set; }

    private IReadOnlyList<SummaryRow> ChartRows =>
        Counts is null
            ? []
            : Counts.Select(pair => new SummaryRow(pair.Key, pair.Value)).ToList();

    private sealed record SummaryRow(string Name, int Count);
}
