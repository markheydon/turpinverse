<BbCard>
    <BbCardHeader>
        <BbCardTitle>Deal Pipeline</BbCardTitle>
    </BbCardHeader>
    <BbCardContent>
        @if (ChartRows.Count == 0)
        {
            <BbTypographyMuted>No deals to chart in the pipeline funnel.</BbTypographyMuted>
        }
        else
        {
            <BbFunnelChart Data="@ChartRows" Height="300px" Title="Deals by stage">
                <BbChartTooltip />
                <BbFunnel DataKey="Count" NameKey="Stage" Sort="FunnelSort.None" LabelFormatter="{b}: {c}" />
            </BbFunnelChart>
        }
        @if (ClosedLostCount > 0)
        {
            <BbTypographyMuted Class="bb:mt-3">
                Closed lost: @ClosedLostCount deal@(ClosedLostCount == 1 ? "" : "s") — outcomes, not a pipeline stage.
            </BbTypographyMuted>
        }
    </BbCardContent>
</BbCard>

@code {
    [Parameter] public IReadOnlyList<DealPreview>? Deals { get; set; }

    private IReadOnlyList<PipelineStageCount> ChartRows =>
        DealPipelineChartData.BuildFunnelRows(Deals?.Select(deal => deal.Stage) ?? []);

    private int ClosedLostCount =>
        DealPipelineChartData.CountClosedLost(Deals?.Select(deal => deal.Stage) ?? []);

    public class DealPreview
    {
        public string Stage { get; set; } = string.Empty;
    }
}
