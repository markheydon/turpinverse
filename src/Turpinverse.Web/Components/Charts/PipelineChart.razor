<BbCard>
    <BbCardHeader>
        <BbCardTitle>Deal Pipeline</BbCardTitle>
    </BbCardHeader>
    <BbCardContent>
        @if (ChartRows.Count == 0)
        {
            <BbTypographyMuted>No deals to chart.</BbTypographyMuted>
        }
        else
        {
            <BbBarChart Data="@ChartRows" Height="300px" Title="Deals by stage">
                <BbChartTooltip />
                <BbXAxis DataKey="Stage" />
                <BbYAxis />
                <BbBar DataKey="Count" />
            </BbBarChart>
        }
    </BbCardContent>
</BbCard>

@code {
    [Parameter] public IReadOnlyList<DealPreview>? Deals { get; set; }

    private IReadOnlyList<StageRow> ChartRows =>
        Deals is null
            ? []
            : Deals.GroupBy(deal => deal.Stage)
                .Select(group => new StageRow(group.Key, group.Count()))
                .OrderBy(row => row.Stage, StringComparer.OrdinalIgnoreCase)
                .ToList();

    public class DealPreview
    {
        public string Stage { get; set; } = string.Empty;
    }

    private sealed record StageRow(string Stage, int Count);
}
