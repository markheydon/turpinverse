@page "/contacts"
@rendermode InteractiveServer

<PageTitle>Contacts - Turpinverse</PageTitle>

<CrmEntityPage DatasetType="contacts"
               Columns="@ContactsColumns"
               FacetColumns="@ContactsFacets"
               RowLinkColumn="firstName"
               RowLinkIdColumn="contactId"
               RowLinkPathPrefix="/contacts">
  <ExportHelp>
    <p class="export-help">
      Contact exports emit one row per account membership. The same <code>contactId</code> and email may appear on multiple rows when a person belongs to more than one account.
      If your CRM unique-keys on email, import by <code>contactId</code> or <code>contactId</code> plus <code>accountId</code>, or apply your own suffix or skip rule.
    </p>
  </ExportHelp>
</CrmEntityPage>

@code {
    private static readonly string[] ContactsColumns =
    [
        "firstName", "lastName", "title", "email", "accountId", "status", "mailingTown"
    ];

    private static readonly string[] ContactsFacets = ["status", "accountId"];
}
