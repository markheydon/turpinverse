@page "/"
@rendermode InteractiveServer
@inject IExportService ExportService
@inject ICanonRepository CanonRepository
@inject CanonValidator CanonValidator
@using Turpinverse.Core.Abstractions
@using Turpinverse.Core.Export
@using Turpinverse.Core.Validation

<PageTitle>Turpinverse</PageTitle>

<BbSectionHeader Title="Turpinverse"
                 Description="Browse canon data mapped to CRM records"
                 HeadingLevel="1"
                 Separator="true">
    <Actions>
        @if (validationResult is not null)
        {
            <BbBadge Variant="@(validationResult.Valid ? BadgeVariant.Secondary : BadgeVariant.Destructive)">
                <LucideIcon Name="@(validationResult.Valid ? "circle-check" : "circle-alert")" Size="16" />
                @(validationResult.Valid ? "Canon valid" : "Canon issues")
            </BbBadge>
        }
    </Actions>
</BbSectionHeader>

@if (loading)
{
    <div class="bb:mt-6 bb:flex bb:items-center bb:gap-2">
        <BbSpinner />
        <BbTypographyMuted>Loading overview...</BbTypographyMuted>
    </div>
}
else if (loadError is not null)
{
    <BbAlert Class="bb:mt-6" Variant="AlertVariant.Danger" Title="Could not load overview">
        @loadError
    </BbAlert>
}
else if (orderedDatasets is not null)
{
    <div class="bb:mt-6 bb:flex bb:flex-wrap bb:gap-4">
        @foreach (var dataset in orderedDatasets)
        {
            var definition = ExportDatasets.TryGet(dataset.Type);
            @if (definition is not null)
            {
                <a href="@definition.Route" class="bb:block bb:min-w-48 bb:flex-1">
                    <BbCard>
                        <BbCardHeader>
                            <BbCardTitle>
                                <span class="bb:inline-flex bb:items-center bb:gap-2">
                                    <LucideIcon Name="@definition.Icon" Size="18" />
                                    @definition.Title
                                </span>
                            </BbCardTitle>
                        </BbCardHeader>
                        <BbCardContent>
                            <BbTypographyH3>@dataset.RowCount</BbTypographyH3>
                            <BbTypographyMuted>records</BbTypographyMuted>
                        </BbCardContent>
                    </BbCard>
                </a>
            }
        }
    </div>

    @if (summaryCounts is not null)
    {
        <div class="bb:mt-6">
            <SummaryChart Counts="summaryCounts" />
        </div>
    }
}

@code {
    private IReadOnlyList<ExportDatasetInfo>? orderedDatasets;
    private CanonValidationResult? validationResult;
    private Dictionary<string, int>? summaryCounts;
    private string? loadError;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var manifest = await ExportService.GetManifestAsync();
            var canon = await CanonRepository.LoadAsync();
            validationResult = CanonValidator.Validate(canon);

            if (!TryGetOrderedDatasets(manifest, out var datasets, out var error))
            {
                loadError = error;
                return;
            }

            orderedDatasets = datasets;
            summaryCounts = datasets.ToDictionary(dataset => dataset.Type, dataset => dataset.RowCount);
        }
        catch
        {
            loadError = "Failed to load overview data.";
        }
        finally
        {
            loading = false;
        }
    }

    private static bool TryGetOrderedDatasets(
        ExportManifest manifest,
        out IReadOnlyList<ExportDatasetInfo> datasets,
        out string error)
    {
        var ordered = new List<ExportDatasetInfo>(ExportDatasets.DisplayOrder.Count);

        foreach (var type in ExportDatasets.DisplayOrder)
        {
            var dataset = manifest.Datasets.FirstOrDefault(d => d.Type == type);
            if (dataset is null)
            {
                datasets = [];
                error = $"Manifest is missing the '{type}' dataset.";
                return false;
            }

            ordered.Add(dataset);
        }

        datasets = ordered;
        error = string.Empty;
        return true;
    }
}
