@page "/deals"
@rendermode InteractiveServer

<PageTitle>Deals - Turpinverse</PageTitle>

<CrmEntityPage DatasetType="deals"
                 Columns="@DealsColumns"
                 FacetColumns="@DealsFacets"
                 ShowPipelineChart="true" />

@code {
    private static readonly string[] DealsColumns =
    [
        "dealName", "stage", "amount", "closeDate", "accountId"
    ];

    private static readonly string[] DealsFacets = ["stage", "accountId"];
}
