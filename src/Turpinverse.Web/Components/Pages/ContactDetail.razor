@page "/contacts/{ContactId}"
@rendermode InteractiveServer
@inject ICanonRepository CanonRepository
@inject CareerPortfolioPresenter Presenter
@inject ProfessionalExtrasPresenter ExtrasPresenter
@using Turpinverse.Core.Abstractions
@using Turpinverse.Core.Career
@using Turpinverse.Core.Models
@using Turpinverse.Core.Profile
@using Turpinverse.Web.Components.Career
@using Turpinverse.Core.Validation
@using Turpinverse.Web.Components.Profile

<PageTitle>@pageTitle - Turpinverse</PageTitle>

@if (loading)
{
    <div class="bb:flex bb:items-center bb:gap-2">
        <BbSpinner />
        <BbTypographyMuted>Loading contact...</BbTypographyMuted>
    </div>
}
else if (persona is null)
{
    <BbEmpty Title="Contact not found"
             Description="@($"No persona matches contact id {ContactId}.")"
             Size="EmptySize.Default">
        <ChildContent>
            <BbButton Href="/contacts" Variant="ButtonVariant.Outline">Back to contacts</BbButton>
        </ChildContent>
    </BbEmpty>
}
else
{
    <BbButton Href="/contacts" Variant="ButtonVariant.Ghost" Class="bb:mb-4">
        <LucideIcon Name="arrow-left" Size="16" />
        Contacts
    </BbButton>

    <BbCard>
        <BbCardContent>
            <div class="bb:flex bb:flex-wrap bb:items-start bb:gap-6">
                @if (!string.IsNullOrWhiteSpace(extras?.Intro?.Photo))
                {
                    <BbAvatar Class="bb:size-40">
                        <img src="@extras.Intro.Photo" alt="@persona.DisplayName" loading="lazy" width="160" height="160" />
                    </BbAvatar>
                }
                <div>
                    <BbTypographyH1>@persona.DisplayName</BbTypographyH1>
                    @if (!suppressTitle)
                    {
                        <BbTypographyMuted>@persona.Title</BbTypographyMuted>
                    }
                    @if (!suppressHeaderEmail)
                    {
                        <BbTypographyMuted>@persona.Email</BbTypographyMuted>
                    }
                    <BbBadge Class="bb:mt-2">@persona.Status</BbBadge>
                </div>
            </div>
        </BbCardContent>
    </BbCard>

    <IntroSection Intro="extras?.Intro" />

    @if (!suppressBiography)
    {
        <BbCard Class="bb:mt-6">
            <BbCardHeader>
                <BbCardTitle>Biography</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <BbTypographyP>@persona.Biography</BbTypographyP>
            </BbCardContent>
        </BbCard>
    }

    <AboutSection Text="@extras?.About" />
    <SkillsSection SectionHeading="@extras?.SkillsHeading" SkillItems="@(extras?.Skills ?? [])" />

    <ExperienceSection Items="experience" />
    <EducationSection Items="education" />
    <ProjectsSection Items="projects" />
    <AchievementsSection Items="achievements" />

    @if (persona.Address is { } mailingAddress && CanonValidator.IsCompleteAddress(mailingAddress))
    {
        <BbCard Class="bb:mt-6">
            <BbCardHeader>
                <BbCardTitle>Mailing address</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <address>
                    <BbTypographyP>@mailingAddress.Address1</BbTypographyP>
                    @if (!string.IsNullOrWhiteSpace(mailingAddress.Address2))
                    {
                        <BbTypographyP>@mailingAddress.Address2</BbTypographyP>
                    }
                    @if (!string.IsNullOrWhiteSpace(mailingAddress.Address3))
                    {
                        <BbTypographyP>@mailingAddress.Address3</BbTypographyP>
                    }
                    <BbTypographyP>@mailingAddress.Town@(string.IsNullOrWhiteSpace(mailingAddress.Region) ? "" : $", {mailingAddress.Region}")</BbTypographyP>
                    <BbTypographyP>@mailingAddress.Postcode</BbTypographyP>
                    <BbTypographyP>@mailingAddress.Country</BbTypographyP>
                </address>
            </BbCardContent>
        </BbCard>
    }

    <ContactExtrasSection Contact="extras?.Contact" />
    <SocialsSection Socials="@(extras?.Socials ?? [])" />

    @if (relatedActivities.Count > 0)
    {
        <BbCard Class="bb:mt-6">
            <BbCardHeader>
                <BbCardTitle>Related activities</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                @foreach (var activity in relatedActivities)
                {
                    <div class="bb:mb-4">
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                            <BbBadge>@activity.Type</BbBadge>
                            <BbTypographyMuted>@activity.ActivityDate</BbTypographyMuted>
                            <BbBadge Variant="BadgeVariant.Outline">@activity.Status</BbBadge>
                        </div>
                        <BbTypographyH4>@activity.Subject</BbTypographyH4>
                        <BbTypographyP>@activity.Description</BbTypographyP>
                    </div>
                    <BbSeparator Class="bb:my-4" />
                }
            </BbCardContent>
        </BbCard>
    }
}

@code {
    [Parameter] public string ContactId { get; set; } = string.Empty;

    private Persona? persona;
    private ProfessionalExtras? extras;
    private IReadOnlyList<Experience> experience = [];
    private IReadOnlyList<Education> education = [];
    private IReadOnlyList<Project> projects = [];
    private IReadOnlyList<Achievement> achievements = [];
    private IReadOnlyList<Activity> relatedActivities = [];
    private bool suppressTitle;
    private bool suppressBiography;
    private bool suppressHeaderEmail;
    private string pageTitle = "Contact";
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var canon = await CanonRepository.LoadAsync();
        persona = canon.Personas.FirstOrDefault(p => p.Id == ContactId);
        if (persona is not null)
        {
            pageTitle = persona.DisplayName;
            extras = ExtrasPresenter.GetExtrasForPersona(canon, ContactId);
            suppressTitle = ExtrasPresenter.ShouldSuppressTitle(extras);
            suppressBiography = ExtrasPresenter.ShouldSuppressBiography(extras);
            suppressHeaderEmail = ExtrasPresenter.ShouldSuppressHeaderEmail(extras);
            experience = Presenter.GetExperienceForPersona(canon, ContactId);
            education = Presenter.GetEducationForPersona(canon, ContactId);
            projects = Presenter.GetProjectsForPersona(canon, ContactId);
            achievements = Presenter.GetAchievementsForPersona(canon, ContactId);
            relatedActivities = ActivityDateSortKey.SortByDateDescending(
                canon.Activities.Where(a =>
                    string.Equals(a.OwnerContactId, ContactId, StringComparison.Ordinal)
                    || (string.Equals(a.RegardingType, "contact", StringComparison.Ordinal)
                        && string.Equals(a.RegardingId, ContactId, StringComparison.Ordinal))));
        }

        loading = false;
    }
}
