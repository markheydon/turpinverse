@page "/contacts/{ContactId}"
@rendermode InteractiveServer
@inject ICanonRepository CanonRepository
@inject CareerPortfolioPresenter Presenter
@inject ProfessionalExtrasPresenter ExtrasPresenter
@using Turpinverse.Core.Abstractions
@using Turpinverse.Core.Career
@using Turpinverse.Core.Models
@using Turpinverse.Core.Profile
@using Turpinverse.Web.Components.Career
@using Turpinverse.Web.Components.Profile

<PageTitle>@pageTitle - Turpinverse</PageTitle>

<div class="page-container contact-detail">
    @if (loading)
    {
        <p>Loading contact...</p>
    }
    else if (persona is null)
    {
        <h1>Contact not found</h1>
        <p>No persona matches contact id <code>@ContactId</code>.</p>
        <a href="/contacts">Back to contacts</a>
    }
    else
    {
        <div class="contact-detail-header">
            <a class="back-link" href="/contacts">← Contacts</a>
            <div class="profile-header">
                @if (!string.IsNullOrWhiteSpace(extras?.Intro?.Photo))
                {
                    <div class="profile-avatar">
                        <img src="@extras.Intro.Photo" alt="@persona.DisplayName" loading="lazy" width="160" height="160">
                    </div>
                }
                <div class="profile-meta">
                    <h1>@persona.DisplayName</h1>
                    @if (!suppressTitle)
                    {
                        <p class="contact-title">@persona.Title</p>
                    }
                    @if (!suppressHeaderEmail)
                    {
                        <p class="contact-email">@persona.Email</p>
                    }
                    <span class="status-badge status-@persona.Status">@persona.Status</span>
                </div>
            </div>
        </div>

        <div class="contact-detail-body">
            <IntroSection Intro="extras?.Intro" />

            @if (!suppressBiography)
            {
                <section class="biography-section">
                    <h2>Biography</h2>
                    <p class="biography">@persona.Biography</p>
                </section>
            }

            <AboutSection Text="@extras?.About" />
            <SkillsSection SectionHeading="@extras?.SkillsHeading" SkillItems="@(extras?.Skills ?? [])" />

            <ExperienceSection Items="experience" />
            <EducationSection Items="education" />
            <ProjectsSection Items="projects" />
            <AchievementsSection Items="achievements" />

            <ContactExtrasSection Contact="extras?.Contact" />
            <SocialsSection Socials="@(extras?.Socials ?? [])" />
        </div>
    }
</div>

@code {
    [Parameter] public string ContactId { get; set; } = string.Empty;

    private Persona? persona;
    private ProfessionalExtras? extras;
    private IReadOnlyList<Experience> experience = [];
    private IReadOnlyList<Education> education = [];
    private IReadOnlyList<Project> projects = [];
    private IReadOnlyList<Achievement> achievements = [];
    private bool suppressTitle;
    private bool suppressBiography;
    private bool suppressHeaderEmail;
    private string pageTitle = "Contact";
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var canon = await CanonRepository.LoadAsync();
        persona = canon.Personas.FirstOrDefault(p => p.Id == ContactId);
        if (persona is not null)
        {
            pageTitle = persona.DisplayName;
            extras = ExtrasPresenter.GetExtrasForPersona(canon, ContactId);
            suppressTitle = ExtrasPresenter.ShouldSuppressTitle(extras);
            suppressBiography = ExtrasPresenter.ShouldSuppressBiography(extras);
            suppressHeaderEmail = ExtrasPresenter.ShouldSuppressHeaderEmail(extras);
            experience = Presenter.GetExperienceForPersona(canon, ContactId);
            education = Presenter.GetEducationForPersona(canon, ContactId);
            projects = Presenter.GetProjectsForPersona(canon, ContactId);
            achievements = Presenter.GetAchievementsForPersona(canon, ContactId);
        }

        loading = false;
    }
}
