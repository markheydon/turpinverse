@page "/cases"
@rendermode InteractiveServer

<PageTitle>Cases - Turpinverse</PageTitle>

<CrmEntityPage DatasetType="cases" Columns="@CasesColumns" FacetColumns="@CasesFacets" />

@code {
    private static readonly string[] CasesColumns =
    [
        "subject", "status", "priority", "contactId", "accountId"
    ];

    private static readonly string[] CasesFacets = ["status", "priority", "accountId"];
}
