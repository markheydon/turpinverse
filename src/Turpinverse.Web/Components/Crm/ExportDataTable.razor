@if (TableRows.Count > 0)
{
    <BbScrollArea Orientation="ScrollAreaOrientation.Horizontal" Type="ScrollAreaType.Auto" Class="bb:w-full">
    <BbDataTable TData="ExportDataRow"
                 Class="bb:min-w-full"
                 Data="@TableRows"
                 ShowToolbar="true"
                 ShowPagination="true"
                 InitialPageSize="20"
                 IsLoading="Loading"
                 AriaLabel="Export preview">
        <Columns>
            @foreach (var header in headers)
            {
                var columnId = header;
                <BbDataTableColumn TData="ExportDataRow" TValue="string"
                                   Id="@columnId"
                                   Header="@FormatLabel(columnId)"
                                   Property="@(row => row.GetValue(columnId))"
                                   Sortable="true"
                                   Filterable="true">
                    <CellTemplate Context="row">
                        @if (ShouldLinkRow(columnId, row, out var href))
                        {
                            <BbLink Href="@href">@row.GetValue(columnId)</BbLink>
                        }
                        else
                        {
                            @row.GetValue(columnId)
                        }
                    </CellTemplate>
                </BbDataTableColumn>
            }
        </Columns>
        <EmptyTemplate>
            <BbTypographyMuted>No records found.</BbTypographyMuted>
        </EmptyTemplate>
    </BbDataTable>
    </BbScrollArea>
}
else if (!Loading)
{
    <BbEmpty Title="No records found"
             Description="There is nothing to show in this preview."
             Size="EmptySize.Small" />
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyDictionary<string, string>> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<string>? Columns { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? RowLinkColumn { get; set; }
    [Parameter] public string? RowLinkPathPrefix { get; set; }
    [Parameter] public string? RowLinkIdColumn { get; set; }

    private IReadOnlyList<string> headers = [];
    private IReadOnlyList<ExportDataRow> TableRows => Rows.Select(row => new ExportDataRow(row)).ToList();

    protected override void OnParametersSet() =>
        headers = ComputeHeaders();

    private IReadOnlyList<string> ComputeHeaders()
    {
        if (Columns is { Count: > 0 })
        {
            return Columns;
        }

        if (Rows.FirstOrDefault() is { } firstRow)
        {
            return firstRow.Keys.ToList();
        }

        return [];
    }

    private bool ShouldLinkRow(string header, ExportDataRow row, out string href)
    {
        href = string.Empty;
        if (string.IsNullOrWhiteSpace(RowLinkColumn)
            || string.IsNullOrWhiteSpace(RowLinkPathPrefix)
            || !string.Equals(header, RowLinkColumn, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var idColumn = string.IsNullOrWhiteSpace(RowLinkIdColumn) ? RowLinkColumn : RowLinkIdColumn;
        var id = row.GetValue(idColumn);
        if (string.IsNullOrWhiteSpace(id))
        {
            return false;
        }

        href = $"{RowLinkPathPrefix.TrimEnd('/')}/{id}";
        return true;
    }

    private static string FormatLabel(string column)
    {
        if (string.IsNullOrEmpty(column))
        {
            return string.Empty;
        }

        return column switch
        {
            "contactId" => "Contact ID",
            "accountId" => "Account ID",
            "dealId" => "Deal ID",
            "caseId" => "Case ID",
            "projectId" => "Project ID",
            "stakeholderContactIds" => "Stakeholder Contact IDs",
            "firstName" => "First Name",
            "lastName" => "Last Name",
            "accountName" => "Account Name",
            "legalName" => "Legal Name",
            "parentAccountId" => "Parent Account",
            "dealName" => "Deal Name",
            "closeDate" => "Close Date",
            "relatedEventId" => "Related Event",
            "registeredOfficeTown" => "Registered Office Town",
            "mailingTown" => "Mailing Town",
            _ => column.Length == 1
                ? column.ToUpperInvariant()
                : char.ToUpper(column[0]) + column[1..]
        };
    }
}
