@if (Rows.Count > 0)
{
    <div class="data-table">
        <div class="data-table-scroll">
            <table>
                <thead>
                    <tr>
                        @foreach (var header in headers)
                        {
                            <th>@FormatLabel(header)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Rows)
                    {
                        <tr>
                            @foreach (var header in headers)
                            {
                                <td>
                                    @if (ShouldLinkRow(header, row, out var href))
                                    {
                                        <a href="@href">@GetValue(row, header)</a>
                                    }
                                    else
                                    {
                                        @GetValue(row, header)
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (!Loading)
{
    <p class="text-slate-500">No records found.</p>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<IReadOnlyDictionary<string, string>> Rows { get; set; } = [];
    [Parameter] public IReadOnlyList<string>? Columns { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? RowLinkColumn { get; set; }
    [Parameter] public string? RowLinkPathPrefix { get; set; }
    [Parameter] public string? RowLinkIdColumn { get; set; }

    private IReadOnlyList<string> headers = [];

    protected override void OnParametersSet()
    {
        headers = ComputeHeaders();
    }

    private IReadOnlyList<string> ComputeHeaders()
    {
        if (Columns is { Count: > 0 })
        {
            return Columns;
        }

        if (Rows.FirstOrDefault() is { } firstRow)
        {
            return firstRow.Keys.ToList();
        }

        return [];
    }

    private static string GetValue(IReadOnlyDictionary<string, string> row, string header) =>
        row.TryGetValue(header, out var value) ? value : string.Empty;

    private bool ShouldLinkRow(string header, IReadOnlyDictionary<string, string> row, out string href)
    {
        href = string.Empty;
        if (string.IsNullOrWhiteSpace(RowLinkColumn)
            || string.IsNullOrWhiteSpace(RowLinkPathPrefix)
            || !string.Equals(header, RowLinkColumn, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var idColumn = string.IsNullOrWhiteSpace(RowLinkIdColumn) ? RowLinkColumn : RowLinkIdColumn;
        if (!row.TryGetValue(idColumn, out var id) || string.IsNullOrWhiteSpace(id))
        {
            return false;
        }

        href = $"{RowLinkPathPrefix.TrimEnd('/')}/{id}";
        return true;
    }

    private static string FormatLabel(string column)
    {
        if (string.IsNullOrEmpty(column))
        {
            return string.Empty;
        }

        return column switch
        {
            "contactId" => "Contact ID",
            "accountId" => "Account ID",
            "dealId" => "Deal ID",
            "caseId" => "Case ID",
            "projectId" => "Project ID",
            "contactIds" => "Contact IDs",
            "firstName" => "First Name",
            "lastName" => "Last Name",
            "accountName" => "Account Name",
            "legalName" => "Legal Name",
            "parentAccountId" => "Parent Account",
            "dealName" => "Deal Name",
            "closeDate" => "Close Date",
            "relatedEventId" => "Related Event",
            "registeredOfficeTown" => "Registered Office Town",
            "mailingTown" => "Mailing Town",
            _ => column.Length == 1
                ? column.ToUpperInvariant()
                : char.ToUpper(column[0]) + column[1..]
        };
    }
}

