@using Turpinverse.Core.Abstractions

<div class="dataset-card @(IsSelected ? "selected" : "")" @onclick="() => OnSelect.InvokeAsync(Dataset.Type)">
    <div class="card-header">
        <LucideIcon Name="@GetIcon(Dataset.Type)" />
        <h3>@FormatTitle(Dataset.Type)</h3>
    </div>
    <p class="row-count">@Dataset.RowCount records</p>
    <p class="description">@GetDescription(Dataset.Type)</p>
    <button class="download-btn" @onclick:stopPropagation="true" @onclick="() => OnDownload.InvokeAsync(Dataset.Type)">
        <LucideIcon Name="download" />
        Download CSV
    </button>
</div>

@code {
    [Parameter, EditorRequired] public ExportDatasetInfo Dataset { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnSelect { get; set; }
    [Parameter, EditorRequired] public EventCallback<string> OnDownload { get; set; }

    private static string FormatTitle(string type) =>
        char.ToUpper(type[0]) + type[1..];

    private static string GetIcon(string type) => type switch
    {
        "contacts" => "users",
        "accounts" => "building",
        "deals" => "handshake",
        "cases" => "ticket",
        _ => "file"
    };

    private static string GetDescription(string type) => type switch
    {
        "contacts" => "Personas mapped to CRM contact records",
        "accounts" => "Organisations mapped to CRM account records",
        "deals" => "Commerce scenarios with pipeline stages",
        "cases" => "Support tickets derived from canon events",
        _ => "Dataset export"
    };
}
