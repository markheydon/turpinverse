@if (SkillItems.Count > 0 && !string.IsNullOrWhiteSpace(SectionHeading))
{
    <section class="profile-section skills-section">
        <h2>@SectionHeading</h2>
        <ul class="skills-list">
            @foreach (var skill in SkillItems)
            {
                <li>@skill</li>
            }
        </ul>
    </section>
}

@code {
    [Parameter] public string? SectionHeading { get; set; }
    [Parameter] public IReadOnlyList<string> SkillItems { get; set; } = [];
}
