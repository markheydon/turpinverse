@using Turpinverse.Core.Career
@using Turpinverse.Core.Models

@if (Contact is not null)
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>Contact</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <BbTypographyP>@Contact.Copy</BbTypographyP>
            <BbLink Href="@($"mailto:{Contact.Email}")">@Contact.Email</BbLink>
            @if (!string.IsNullOrWhiteSpace(Contact.Phone))
            {
                <BbTypographyMuted>@Contact.Phone</BbTypographyMuted>
            }
            @if (Contact.Cta is not null)
            {
                <BbButton Variant="ButtonVariant.Link"
                          Href="@CareerLinkResolver.ResolveForPublication(Contact.Cta.Url)"
                          Class="bb:mt-2">
                    @(Contact.Cta.Label ?? Contact.Cta.Name ?? "Get in touch")
                </BbButton>
            }
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public ContactExtras? Contact { get; set; }
}
