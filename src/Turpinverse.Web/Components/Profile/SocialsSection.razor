@using Turpinverse.Core.Models

@if (Socials.Count > 0)
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>Socials</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <div class="bb:flex bb:flex-wrap bb:gap-2">
                @foreach (var social in Socials)
                {
                    <BbChip>
                        <BbLink Href="@social.Url" Target="_blank" Rel="noopener noreferrer">@social.Network</BbLink>
                    </BbChip>
                }
            </div>
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public IReadOnlyList<ProfessionalSocial> Socials { get; set; } = [];
}
