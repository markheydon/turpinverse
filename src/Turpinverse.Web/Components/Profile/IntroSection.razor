@using Turpinverse.Core.Career
@using Turpinverse.Core.Models

@if (Intro is not null)
{
    <BbCard Class="bb:mt-6">
        <BbCardContent>
            <BbTypographyP>@Intro.ShortIntro</BbTypographyP>
            <BbTypographyH3>@Intro.Headline</BbTypographyH3>
            <BbTypographyMuted>@Intro.Subtitle</BbTypographyMuted>
            @if (Intro.Cta is not null)
            {
                <BbButton Variant="ButtonVariant.Link"
                          Href="@CareerLinkResolver.ResolveForPublication(Intro.Cta.Url)"
                          Class="bb:mt-2">
                    @(Intro.Cta.Label ?? Intro.Cta.Name ?? "Learn more")
                </BbButton>
            }
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public IntroCopy? Intro { get; set; }
}
