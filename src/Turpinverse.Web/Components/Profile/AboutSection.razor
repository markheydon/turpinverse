@if (!string.IsNullOrWhiteSpace(Text))
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>About</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <BbTypographyP>@Text</BbTypographyP>
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public string? Text { get; set; }
}
