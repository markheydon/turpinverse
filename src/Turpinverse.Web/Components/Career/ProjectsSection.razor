@using Turpinverse.Core.Career
@using Turpinverse.Core.Models

@if (Items.Count > 0)
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>Projects</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            @foreach (var project in Items)
            {
                <article class="bb:mb-6">
                    @if (!string.IsNullOrWhiteSpace(project.Image))
                    {
                        <BbAspectRatio Ratio="1.777" Class="bb:mb-4">
                            <img src="@project.Image" alt="@project.Title" loading="lazy" width="640" height="360" />
                        </BbAspectRatio>
                    }
                    <BbTypographyH4>@project.Title</BbTypographyH4>
                    <BbTypographyP>@project.Summary</BbTypographyP>
                    <BbTypographyMuted>
                        Account:
                        <BbLink Href="@($"/organisations/{project.OrganisationId}")">@project.OrganisationId</BbLink>
                    </BbTypographyMuted>
                    @if (project.Tags.Count > 0)
                    {
                        <div class="bb:mt-2 bb:flex bb:flex-wrap bb:gap-2">
                            @foreach (var tag in project.Tags)
                            {
                                <BbChip>@tag</BbChip>
                            }
                        </div>
                    }
                    @if (project.Links.Count > 0)
                    {
                        <ul class="bb:mt-2">
                            @foreach (var link in project.Links)
                            {
                                <li>
                                    <BbLink Href="@CareerLinkResolver.ResolveForPublication(link.Url)">
                                        @(link.Label ?? link.Name ?? (string.IsNullOrWhiteSpace(link.Icon) ? "Link" : "View details"))
                                    </BbLink>
                                </li>
                            }
                        </ul>
                    }
                    @if (project.FeaturedCta is { } cta)
                    {
                        <BbButton Variant="ButtonVariant.Link"
                                  Href="@CareerLinkResolver.ResolveForPublication(cta.Url)"
                                  Class="bb:mt-2">
                            @(cta.Name ?? cta.Label ?? "View project")
                        </BbButton>
                    }
                </article>
                <BbSeparator Class="bb:my-4" />
            }
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public IReadOnlyList<Project> Items { get; set; } = [];
}
