@using Turpinverse.Core.Career
@using Turpinverse.Core.Models

@if (Items.Count > 0)
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>Achievements</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            @foreach (var achievement in Items)
            {
                <article class="bb:mb-6">
                    @if (!string.IsNullOrWhiteSpace(achievement.Image))
                    {
                        <BbAspectRatio Ratio="1.777" Class="bb:mb-4">
                            <img src="@achievement.Image" alt="@achievement.Title" loading="lazy" width="640" height="360" />
                        </BbAspectRatio>
                    }
                    <BbTypographyH4>
                        @if (!string.IsNullOrWhiteSpace(achievement.Url))
                        {
                            <BbLink Href="@CareerLinkResolver.ResolveForPublication(achievement.Url)">@achievement.Title</BbLink>
                        }
                        else
                        {
                            @achievement.Title
                        }
                    </BbTypographyH4>
                    <BbTypographyP>@achievement.Summary</BbTypographyP>
                </article>
                <BbSeparator Class="bb:my-4" />
            }
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public IReadOnlyList<Achievement> Items { get; set; } = [];
}
