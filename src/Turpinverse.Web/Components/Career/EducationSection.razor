@using Turpinverse.Core.Career
@using Turpinverse.Core.Models

@if (Items.Count > 0)
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>Education</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            @foreach (var entry in Items)
            {
                <div class="bb:mb-6">
                    <BbTypographyH4>@entry.Title</BbTypographyH4>
                    <BbTypographyMuted>@entry.InstitutionName</BbTypographyMuted>
                    @{
                        var dateRange = FormatDateRange(entry);
                    }
                    @if (!string.IsNullOrWhiteSpace(dateRange))
                    {
                        <BbTypographyMuted>@dateRange</BbTypographyMuted>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Grade))
                    {
                        <BbTypographyP>@entry.Grade</BbTypographyP>
                    }
                    @if (!string.IsNullOrWhiteSpace(entry.Description))
                    {
                        <BbTypographyP>@entry.Description</BbTypographyP>
                    }
                    @if (entry.FeaturedLink is { } link)
                    {
                        <BbButton Variant="ButtonVariant.Link" Href="@CareerLinkResolver.ResolveForPublication(link.Url)">
                            @(link.Name ?? link.Label ?? "Learn more")
                        </BbButton>
                    }
                </div>
                <BbSeparator Class="bb:my-4" />
            }
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public IReadOnlyList<Education> Items { get; set; } = [];

    private static string? FormatDateRange(Education entry)
    {
        if (!string.IsNullOrWhiteSpace(entry.DisplayRange))
        {
            return entry.DisplayRange;
        }

        if (string.IsNullOrWhiteSpace(entry.Start))
        {
            return null;
        }

        return string.IsNullOrWhiteSpace(entry.End)
            ? $"{entry.Start} – Present"
            : $"{entry.Start} – {entry.End}";
    }
}
