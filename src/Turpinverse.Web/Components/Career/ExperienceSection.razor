@using Turpinverse.Core.Career
@using Turpinverse.Core.Models

@if (Items.Count > 0)
{
    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>Experience</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            @foreach (var grouping in Items)
            {
                <div class="bb:mb-6">
                    <BbTypographyH4>
                        @if (!string.IsNullOrWhiteSpace(grouping.OrganisationId))
                        {
                            <BbLink Href="@($"/organisations/{grouping.OrganisationId}")">@grouping.OrganisationName</BbLink>
                        }
                        else
                        {
                            @grouping.OrganisationName
                        }
                    </BbTypographyH4>
                    @foreach (var role in grouping.Roles)
                    {
                        <div class="bb:mt-4">
                            <BbTypographyH4>@role.Title</BbTypographyH4>
                            <BbTypographyMuted>@FormatDateRange(role)</BbTypographyMuted>
                            <BbTypographyP>@role.Description</BbTypographyP>
                            @if (!string.IsNullOrWhiteSpace(role.ExtraInfo))
                            {
                                <BbTypographyMuted Title="@role.ExtraInfo">@role.ExtraInfo</BbTypographyMuted>
                            }
                            @if (role.FeaturedLinks.Count > 0)
                            {
                                <ul class="bb:mt-2">
                                    @foreach (var link in role.FeaturedLinks)
                                    {
                                        <li>
                                            <BbLink Href="@CareerLinkResolver.ResolveForPublication(link.Url)" Title="@link.Tooltip">
                                                @(link.Label ?? link.Name ?? (string.IsNullOrWhiteSpace(link.Icon) ? "Link" : "View details"))
                                            </BbLink>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <BbSeparator Class="bb:my-4" />
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>
}

@code {
    [Parameter] public IReadOnlyList<Experience> Items { get; set; } = [];

    private static string FormatDateRange(Role role)
    {
        if (!string.IsNullOrWhiteSpace(role.DisplayRange))
        {
            return role.DisplayRange;
        }

        return string.IsNullOrWhiteSpace(role.End)
            ? $"{role.Start} – Present"
            : $"{role.Start} – {role.End}";
    }
}
