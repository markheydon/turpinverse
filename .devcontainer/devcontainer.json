{
    "name": "Turpinverse",
    "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
    "features": {
        "ghcr.io/markheydon/devcontainer-features/aspire-cli:1": {},
        "ghcr.io/markheydon/devcontainer-features/dev-agent-tools:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:4": {},
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/hugo:1": {
            "version": "0.165.0",
            "extended": true
        },
        "ghcr.io/devcontainers/features/go:1": {
            "version": "1.26.5"
        },
        "ghcr.io/stu-bell/devcontainer-features/cursor-cli:0": {}
    },
    "mounts": [
        {
            "type": "volume",
            "source": "x509stores",
            "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
        }
    ],
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb",
        "storage": "32gb"
    },
    "onCreateCommand": "bash .devcontainer/setup-dotnet-dev-cert.sh && sudo apt-get update && sudo apt-get install -y libnss3-tools shellcheck",
    "containerEnv": {
        "ASPNETCORE_ENVIRONMENT": "Development"
    },
    "remoteEnv": {
        "SSL_CERT_DIR": "/usr/lib/ssl/certs:/home/vscode/.aspnet/dev-certs/trust",
        "CURSOR_API_KEY": "${localEnv:CURSOR_API_KEY}",
        "GH_TOKEN": "${localEnv:GH_TOKEN}",
        "GH_HOST": "github.com"
    },
    "postStartCommand": "aspire certs trust --non-interactive",
    "postCreateCommand": "bash .devcontainer/post-create.sh && bash .devcontainer/install-playwright-browsers.sh",
    "updateContentCommand": "dotnet restore Turpinverse.slnx",
    "forwardPorts": [
        1313,
        5051,
        7154,
        8080,
        15183,
        17180
    ],
    "portsAttributes": {
        "1313": {
            "label": "Hugo (dev server)",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "Hugo (nginx preview)",
            "onAutoForward": "silent"
        },
        "5051": {
            "label": "Blazor (HTTP)",
            "onAutoForward": "notify"
        },
        "7154": {
            "label": "Blazor (HTTPS)",
            "onAutoForward": "silent"
        },
        "15183": {
            "label": "AppHost (HTTP)",
            "onAutoForward": "notify"
        },
        "17180": {
            "label": "AppHost (HTTPS)",
            "onAutoForward": "silent"
        }
    },
    "otherPortsAttributes": {
        "onAutoForward": "notify"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "microsoft-aspire.aspire-vscode",
                "ms-vscode.powershell",
                "editorconfig.editorconfig",
                "timonwong.shellcheck",
                "github.vscode-github-actions",
                "redhat.vscode-yaml",
                "ms-playwright.playwright",
                "streetsidesoftware.code-spell-checker"
            ]
        }
    }
}