{
    "name": "Turpinverse",
    "image": "mcr.microsoft.com/devcontainers/base:3-ubuntu24.04",
    "features": {
        "ghcr.io/microsoft/aspire-devcontainer-feature/aspire:3": {},
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
        "ghcr.io/devcontainers/features/node:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/dotnet:2": {
            "version": "10.0"
        },
        "ghcr.io/devcontainers/features/powershell:2": {},
        "ghcr.io/markheydon/devcontainer-features/copilot-likes:1": {}
    },
    "onCreateCommand": "sudo apt-get update && sudo apt-get install -y libnss3-tools",
    "containerEnv": {
        "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs",
        "ASPNETCORE_ENVIRONMENT": "Development"
    },
    "postStartCommand": "aspire certs trust --non-interactive",
    "postCreateCommand": "dotnet restore Turpinverse.slnx",
    "updateContentCommand": "dotnet restore Turpinverse.slnx",
    "hostRequirements": {
        "cpus": 4,
        "memory": "8gb",
        "storage": "32gb"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "microsoft-aspire.aspire-vscode",
                "GitHub.copilot-chat",
                "ms-dotnettools.csdevkit"
            ]
        }
    }
}